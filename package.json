  "scripts": {
    "start": "react-scripts start",
    "build": "INLINE_RUNTIME_CHUNK=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:vercel": "vercel --prod",
    "init:firebase": "firebase init",
    "login:firebase": "firebase login",
    "analyze": "npm run build && npx serve -s build",
    "lint:ci": "eslint src --ext .js --no-eslintrc -c .eslintrc.ci.js --max-warnings 0",
    "verify": "npm run lint:ci && CI=true react-scripts test --watchAll=false && CI=true DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "test:e2e": "playwright test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
